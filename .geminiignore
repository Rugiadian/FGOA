# AI Agent Context Ignore File (.geminiignore)
# FGOA 토큰 최적화를 위해 AI 컨텍스트 수집 및 검색 대상에서 제외하는 목록

# 1. 작업 이력 (기록 보관 전용 - AI 컨텍스트 주입 및 전역 검색 배제)
history/
history/**

# 2. Python 캐시 및 컴파일된 바이트코드
__pycache__/
**/__pycache__/**
*.py[cod]
*$py.class
.pytest_cache/

# 3. 로그 및 크래시 리포트
*.log
fgoa_crash.log
fgoa_debug.log

# 4. 대용량 테스트/프로젝트 JSON 덤프 및 런타임 설정
event 1.json
fgoa_project.json
fgoa_config.json

# 5. 레퍼런스 이미지 및 대용량 바이너리 미디어 (AI 컨텍스트 주입 배제)
references/
references/**
*.png
*.jpg
*.jpeg
*.bmp
*.ico
*.gif

# 6. IDE 및 빌드 임시 파일
.vs/
.idea/
.vscode/
[Tt]emp/
[Tt]mp/

# 7. 가상 환경
venv/
.venv/
env/
